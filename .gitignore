# ===== 环境与密钥 =====
.env
.env.local

# 启动脚本记录的运行时端口与日志
.kh_runtime.json
_backend.log
_frontend.log

# ===== 运行期数据（正式数据 / 缓存 / 导出 / 日志）=====
data/
!data/.gitkeep

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
# pytest 的临时目录：本机把 %TEMP% 下的临时目录纳入「安全删除」保护，
# 跑测试时会被中断，故改用项目内固定目录（见 README「测试」一节）
.pytest_tmp/
.mypy_cache/
.ruff_cache/

# ===== Node / 前端 =====
node_modules/
frontend/dist/
frontend/.vite/
*.local

# ===== 备份与数据库文件 =====
*.bak
*.backup
backups/
*.db
*.sqlite
*.sqlite3

# ===== 编辑器 / 系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db

# ===== AI 助手本地工作记忆（非项目源码）=====
.workbuddy/
.workbuddy-ai/

# ===== 构建产物 =====
frontend/tsconfig.tsbuildinfo
frontend/vite.config.ts.timestamp-*.mjs
