# ===== KnowledgeHub 配置模板 =====
# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，不要提交到仓库。

# ---------- 数据库（PostgreSQL 主方案）----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=knowledgehub
DB_USER=kh_app
DB_PASSWORD=123456
# 也可直接用完整连接串覆盖上面的分项配置：
# DATABASE_URL=postgresql+psycopg://kh_app:123456@127.0.0.1:5432/knowledgehub

# ---------- 存储模式 ----------
# postgres（默认）| sqlite（回退方案）
STORAGE_MODE=postgres

# ---------- 数据目录 ----------
DATA_DIR=./data

# ---------- 服务地址 ----------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---------- 上传限制（MB）----------
MAX_UPLOAD_MB=50

# ---------- AI 服务 ----------
# local = 本地模型（Ollama 兼容）；external = 外部 OpenAI 兼容 API
AI_MODE=local
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=
CHAT_MODEL=
# 嵌入服务可与对话服务不同（EMBEDDING_BASE_URL 留空则复用对话服务）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
REQUEST_TIMEOUT=60

# ---------- 检索参数 ----------
HYBRID_ALPHA=0.3
HYBRID_BETA=0.7
SEARCH_TOP_K=8
CHUNK_SIZE=800
CHUNK_OVERLAP=100
