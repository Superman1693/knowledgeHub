# 统一换行符，避免跨平台协作时产生整文件 diff

# 默认：仓库内使用 LF，检出时按平台自动转换
* text=auto eol=lf

# Windows 批处理必须是 CRLF（cmd.exe 对 LF 兼容性不佳）
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.woff binary
*.woff2 binary

# 锁文件不参与 diff 统计
package-lock.json -diff linguist-generated
